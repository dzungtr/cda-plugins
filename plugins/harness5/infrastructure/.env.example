# Real Anthropic API key (never commit the real value)
ANTHROPIC_API_KEY=sk-ant-...

# --- Graphiti memory MCP server (`graphiti-mcp` service) ---
# LLM extraction + embeddings talk directly to whatever OpenAI-compatible
# provider you point at (this compose stack no longer runs an in-network LLM
# gateway). All three vars below are required — `docker compose up` will fail
# fast with a clear error if any are unset.
#
# OPENAI_API_URL must be the full /v1 base, e.g. https://api.openai.com/v1
# or any provider's OpenAI-compatible surface.
OPENAI_API_KEY=sk-...
OPENAI_API_URL=https://api.openai.com/v1

# Cheap/fast model for extraction — every episode triggers several LLM calls
# (entity extraction, dedup, summarization), so pick the cheapest model that
# reliably emits well-formed structured JSON. `claude-haiku-4-5` is a sensible
# default if your provider exposes it; swap for whatever your OPENAI_API_URL
# server actually serves.
MEM_EXTRACTOR_MODEL=claude-haiku-4-5

# Embedder endpoint is decoupled from OPENAI_API_URL — set it independently
# to point embeddings at a different provider (e.g. local Ollama) than the
# LLM extractor above. Must be the full /v1 base of an OpenAI-compatible
# embeddings server.
EMBEDDER_API_URL=https://api.openai.com/v1
MEM_EMBED_MODEL=text-embedding-3-small
EMBEDDER_DIMENSIONS=1536

# --- Local embedder provider example ---
# To run embeddings through local Ollama instead, replace the three values
# above with the following. Both nomic-embed-text and
# nomic-embed-text-v2-moe return 768-dimensional vectors through Ollama's
# OpenAI-compatible /v1/embeddings endpoint. The graphiti-mcp container can
# reach the host through the extra_hosts entry in docker-compose.yml.
# EMBEDDER_API_URL=http://host.docker.internal:11434/v1
# MEM_EMBED_MODEL=nomic-embed-text
# EMBEDDER_DIMENSIONS=768

# --- FalkorDB (bundled inside the graphiti-mcp container) ---
FALKORDB_PASSWORD=
FALKORDB_DATABASE=default_db
FALKORDB_BROWSER_ENABLED=1

# --- Graphiti namespace fallback (per-call group_id in the skill overrides this) ---
GRAPHITI_GROUP_ID=main

# --- Ingestion concurrency — tune against the upstream provider's rate limit ---
SEMAPHORE_LIMIT=5

# --- Host port overrides ---
# Defaults below are deliberately NOT the upstream defaults (8000/6379/3000)
# to avoid colliding with other services in this compose stack.
GRAPHITI_MCP_HTTP_PORT=8121
FALKORDB_REDIS_PORT=6380
FALKORDB_BROWSER_PORT=3010

# --- SigNoz observability backend (ADR 0004, epic #84 slice #86) ---
# Vendored from the official v0.129.0 docker-compose distribution (the last
# release shipping deploy/docker/ — upstream has since moved to Foundry).
# Image tags are pinned in docker-compose.yml; override only to upgrade the
# tested pair together.
#SIGNOZ_VERSION=v0.129.0
#SIGNOZ_OTELCOL_TAG=v0.144.5

# JWT signing secret for the SigNoz query service (upstream default is
# `secret`; any non-empty string works for local dev).
SIGNOZ_JWT_SECRET=local-dev-signoz-jwt

# Host ports. UI default 8080 matches upstream (free in this stack); the OTLP
# ports use the standard 4317 (gRPC) / 4318 (HTTP) upstream defaults, reclaimed
# now that the intermediary `otelcol` collector (which historically bound
# them) is fully removed. Both OTLP ports bind loopback only.
SIGNOZ_UI_PORT=8080
SIGNOZ_OTLP_GRPC_PORT=4317
SIGNOZ_OTLP_HTTP_PORT=4318

# --- SigNoz auth disabled (impersonation mode) ---
# Local dev: every request is treated as the auto-provisioned root admin, so
# the UI and API need no login. Requires SigNoz >= v0.126.0 (identN env
# support) and >= v0.112.0 (root-user provisioning). All three IDENTN toggles
# must be set together per upstream impersonation-mode docs. Change the root
# user's email/password here; the org is created on first start.
SIGNOZ_IDENTN_IMPERSONATION_ENABLED=true
SIGNOZ_IDENTN_TOKENIZER_ENABLED=false
SIGNOZ_IDENTN_APIKEY_ENABLED=false
SIGNOZ_USER_ROOT_ENABLED=true
SIGNOZ_USER_ROOT_EMAIL=admin@local.dev
SIGNOZ_USER_ROOT_PASSWORD=SignozLocalDev123!
SIGNOZ_USER_ROOT_ORG_NAME=default

# --- SigNoz MCP server access layer ---
# Official `SigNoz/signoz-mcp-server`, run as its own `signoz-mcp` container
# in docker-compose.yml, HTTP transport. It talks to the `signoz` service
# in-network; `.mcp.json` at the repo root reaches it via the host-published
# port below. None of the following need to be set for it to work out of the
# box against this repo's own stack.
#
# Pin the signoz-mcp-server Docker image to a specific release (Docker Hub:
# https://hub.docker.com/r/signoz/signoz-mcp-server/tags) — upgrade only by
# bumping this together with re-testing.
#SIGNOZ_MCP_SERVER_TAG=v0.8.0
#
# Host port for the MCP server's own HTTP endpoint (container listens on
# 8000 internally regardless of this value); loopback-only like every other
# service in this file.
#SIGNOZ_MCP_HTTP_PORT=3018
#
# URL .mcp.json uses to reach the signoz-mcp container from the host
# (default: http://localhost:3018, i.e. SIGNOZ_MCP_HTTP_PORT above):
#SIGNOZ_MCP_URL=http://localhost:3018
#
# Non-secret placeholder: the signoz-mcp-server binary hard-requires a
# non-empty SIGNOZ_API_KEY string regardless of backend auth mode (its own
# startup validation), but this repo's SigNoz backend runs in no-auth
# impersonation mode above and never actually checks it. Only override this
# if you point the container's SIGNOZ_URL at a real, auth-enabled instance.
#SIGNOZ_MCP_API_KEY=not-required-impersonation-mode
#
#SIGNOZ_MCP_LOG_LEVEL=info
